// CODICS Prisma Schema
// Prisma 7.10.0

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  hod
  lecturer
  course_rep
  student
}

enum UserStatus {
  invited
  active
  suspended
}

enum Semester {
  first
  second
}

enum EnrollmentType {
  regular
  carryover
  elective
}

enum MaterialType {
  pdf
  slides
  note
  link
}

enum MaterialStatus {
  draft
  published
}

enum AudienceScope {
  faculty
  department
  level
  course
}

enum AuthProvider {
  local
  google
  google_linked
}

enum StaffInvitationStatus {
  pending
  accepted
  expired
  revoked
}

enum AssignmentStatus {
  draft
  published
  closed
}

enum ExamType {
  first_semester
  second_semester
  mid_semester
  test
}

enum PastQuestionStatus {
  pending
  approved
  rejected
}

enum ReportStatus {
  pending
  reviewed
  dismissed
}

enum RoleScopeType {
  faculty
  department
  level
  course
}

enum AttendanceSessionStatus {
  open
  closed
}

enum AttendanceRecordStatus {
  present
  late
  absent
  excused
}

enum AttendanceRecordSource {
  self
  manual
}

enum FileCategory {
  course_material
  assignment_submission
  past_question
  onboarding_document
}

enum OnboardingStatus {
  draft
  submitted
  under_review
  action_required
  verified
  rejected
  matriculated
}

enum OnboardingDocType {
  jamb_result
  o_level
  birth_certificate
  lga_identification
  admission_letter
  other
}

enum DocReviewStatus {
  pending
  verified
  rejected
}

model Department {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  courses Course[]
  onboardingApps OnboardingApplication[]
  staffInvitations StaffInvitation[]
}

model Setting {
  id        String   @id @default(uuid())
  session   String
  semester  Semester
  updatedAt DateTime @updatedAt
}

model User {
  id             String     @id @default(uuid())
  email          String?    @unique
  matricNo       String?    @unique
  staffId        String?    @unique
  fullName       String
  passwordHash   String?
  role           Role       @default(student)
  departmentId   String?
  level          Int?
  status         UserStatus @default(invited)
  googleId       String?    @unique
  googleEmail    String?
  authProvider   AuthProvider @default(local)
  avatarUrl      String?
  baseRole       Role       @default(student)
  repTermStart   DateTime?
  repTermEnd     DateTime?
  activatedAt    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  department                 Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  enrollments                Enrollment[]
  lecturerOfferings          OfferingLecturer[]
  authoredNotices            Notice[]               @relation("AuthoredNotices")
  noticeReads                NoticeRead[]
  submissions                Submission[]
  uploadedPQs                PastQuestion[]         @relation("UploadedPQs")
  approvedPQs                PastQuestion[]         @relation("ApprovedPQs")
  pqReports                  PastQuestionReport[]
  roleAssignments            RoleAssignment[]       @relation("UserRoleAssignments")
  createdAssignments         RoleAssignment[]       @relation("CreatedRoleAssignments")
  refreshTokens              RefreshToken[]
  activationCodes            ActivationCode[]
  passwordResets             PasswordReset[]
  auditLogs                  AuditLog[]
  createdAttendanceSessions  AttendanceSession[]    @relation("CreatedAttendanceSessions")
  attendanceRecords          AttendanceRecord[]     @relation("StudentAttendanceRecords")
  adjustedAttendance         AttendanceAdjustment[] @relation("AdjustedAttendanceRecords")
  createdCalendarEvents      CalendarEvent[]        @relation("CreatedCalendarEvents")
  createdTimetableExceptions TimetableException[]   @relation("CreatedTimetableExceptions")
  uploadedFiles              StoredFile[]           @relation("UploadedFiles")
  materialProgress           UserMaterialProgress[]
  pushSubscriptions          PushSubscription[]
  convertedOnboardingApp     OnboardingApplication?   @relation("ConvertedStudentApplication")
  reviewedOnboardingDocs     OnboardingDocument[]     @relation("ReviewedOnboardingDocuments")
  loggedOnboardingReviews    OnboardingReviewLog[]    @relation("LoggedOnboardingReviews")
  publishedRegGuides         RegistrationGuide[]      @relation("PublishedRegistrationGuides")
  sentStaffInvitations       StaffInvitation[]        @relation("SentStaffInvitations")
  acceptedStaffInvitation    StaffInvitation?         @relation("AcceptedStaffInvitation")

  @@index([departmentId])
  @@index([role])
  @@index([status])
}

model Course {
  id           String   @id @default(uuid())
  code         String   @unique
  title        String
  units        Int
  departmentId String
  level        Int
  semester     Semester
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  offerings  Offering[]

  @@index([departmentId])
  @@index([level, semester])
}

model Offering {
  id        String   @id @default(uuid())
  courseId  String
  session   String
  semester  Semester
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course             Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecturers          OfferingLecturer[]
  enrollments        Enrollment[]
  modules            Module[]
  materials          Material[]
  assignments        Assignment[]
  attendanceSessions AttendanceSession[]
  timetableSlots     TimetableSlot[]
  materialProgress   UserMaterialProgress[]

  @@unique([courseId, session, semester])
  @@index([courseId])
  @@index([session, semester])
}

model OfferingLecturer {
  id         String   @id @default(uuid())
  offeringId String
  userId     String
  createdAt  DateTime @default(now())

  offering Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([offeringId, userId])
  @@index([offeringId])
  @@index([userId])
}

model Enrollment {
  id         String         @id @default(uuid())
  offeringId String
  userId     String
  type       EnrollmentType @default(regular)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  offering Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([offeringId, userId])
  @@index([offeringId])
  @@index([userId])
}

model Module {
  id          String    @id @default(uuid())
  offeringId  String
  title       String
  order       Int
  weekNumber  Int?
  description String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  offering  Offering   @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  materials Material[]

  @@index([offeringId])
  @@index([deletedAt])
}

model Material {
  id         String         @id @default(uuid())
  moduleId   String
  offeringId String
  type       MaterialType
  title      String
  status     MaterialStatus @default(draft)
  fileKey    String?
  fileName   String?
  sizeBytes  Int?
  mimeType   String?
  sha256     String?
  uploaderId String?
  url        String?
  body       String?
  deletedAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  module   Module                 @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  offering Offering               @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  progress UserMaterialProgress[]

  @@index([moduleId])
  @@index([offeringId])
  @@index([deletedAt])
  @@index([status])
}

model Notice {
  id                   String        @id @default(uuid())
  authorId             String
  title                String
  body                 String
  scope                AudienceScope
  targetDepartmentCode String?
  targetLevel          Int?
  targetCourseCode     String?
  isUrgent             Boolean       @default(false)
  isHidden             Boolean       @default(false)
  hiddenReason         String?
  hiddenBy             String?
  hiddenAt             DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  author User         @relation("AuthoredNotices", fields: [authorId], references: [id], onDelete: Cascade)
  reads  NoticeRead[]

  @@index([authorId])
  @@index([scope])
  @@index([targetDepartmentCode])
  @@index([targetLevel])
  @@index([targetCourseCode])
  @@index([isHidden])
  @@index([createdAt])
}

model NoticeRead {
  id       String   @id @default(uuid())
  noticeId String
  userId   String
  readAt   DateTime @default(now())

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noticeId, userId])
  @@index([noticeId])
  @@index([userId])
}

model Assignment {
  id                String           @id @default(uuid())
  offeringId        String
  title             String
  instructions      String
  deadline          DateTime
  allowLate         Boolean          @default(false)
  allowedTypes      String[]
  maxSizeBytes      Int              @default(10485760)
  status            AssignmentStatus @default(draft)
  studentExtensions Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  offering    Offering     @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([offeringId])
  @@index([deadline])
  @@index([status])
}

model Submission {
  id           String   @id @default(uuid())
  assignmentId String
  studentId    String
  score        Float?
  feedback     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignment Assignment          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  versions   SubmissionVersion[]

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
}

model SubmissionVersion {
  id           String   @id @default(uuid())
  submissionId String
  version      Int
  fileKey      String
  fileName     String
  sizeBytes    Int
  mimeType     String
  sha256       String
  submittedAt  DateTime @default(now())
  isLate       Boolean  @default(false)

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, version])
  @@index([submissionId])
}

model PastQuestion {
  id              String             @id @default(uuid())
  uploaderId      String
  courseCode      String
  session         String
  semester        Semester
  examType        ExamType
  fileKey         String?
  fileName        String?
  sizeBytes       Int?
  mimeType        String?
  sha256          String?
  status          PastQuestionStatus @default(pending)
  rejectionReason String?
  approvedBy      String?
  deletedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  uploader User                 @relation("UploadedPQs", fields: [uploaderId], references: [id], onDelete: Cascade)
  approver User?                @relation("ApprovedPQs", fields: [approvedBy], references: [id], onDelete: SetNull)
  reports  PastQuestionReport[]

  @@index([uploaderId])
  @@index([courseCode])
  @@index([session, semester])
  @@index([status])
  @@index([deletedAt])
}

model PastQuestionReport {
  id             String       @id @default(uuid())
  pastQuestionId String
  reportedBy     String
  reason         String
  note           String?
  status         ReportStatus @default(pending)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  pastQuestion PastQuestion @relation(fields: [pastQuestionId], references: [id], onDelete: Cascade)
  reporter     User         @relation(fields: [reportedBy], references: [id], onDelete: Cascade)

  @@index([pastQuestionId])
  @@index([reportedBy])
  @@index([status])
}

model RoleAssignment {
  id        String        @id @default(uuid())
  userId    String
  role      Role
  scopeType RoleScopeType
  scopeId   String
  validFrom DateTime
  validTo   DateTime
  createdBy String
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user    User @relation("UserRoleAssignments", fields: [userId], references: [id], onDelete: Cascade)
  creator User @relation("CreatedRoleAssignments", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([role])
  @@index([scopeType, scopeId])
  @@index([isActive, validTo])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorName  String?
  actorRole  String?
  action     String
  targetType String
  targetId   String
  targetName String?
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  familyId     String
  tokenHash    String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([tokenHash])
}

model ActivationCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model AttendanceSession {
  id           String                  @id @default(uuid())
  offeringId   String
  createdBy    String
  startsAt     DateTime
  closesAt     DateTime
  lateAfterMin Int                     @default(15)
  rotateSec    Int                     @default(30)
  status       AttendanceSessionStatus @default(open)
  secret       String
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  offering Offering           @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  creator  User               @relation("CreatedAttendanceSessions", fields: [createdBy], references: [id], onDelete: Cascade)
  records  AttendanceRecord[]

  @@index([offeringId])
  @@index([createdBy])
  @@index([status])
  @@index([startsAt])
}

model AttendanceRecord {
  id          String                 @id @default(uuid())
  sessionId   String
  studentId   String
  status      AttendanceRecordStatus @default(present)
  checkedInAt DateTime               @default(now())
  source      AttendanceRecordSource @default(self)
  reason      String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  session     AttendanceSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student     User                   @relation("StudentAttendanceRecords", fields: [studentId], references: [id], onDelete: Cascade)
  adjustments AttendanceAdjustment[]

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
  @@index([status])
  @@index([checkedInAt])
}

model AttendanceAdjustment {
  id         String                 @id @default(uuid())
  recordId   String
  fromStatus AttendanceRecordStatus
  toStatus   AttendanceRecordStatus
  reason     String
  adjustedBy String
  createdAt  DateTime               @default(now())

  record   AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  adjuster User             @relation("AdjustedAttendanceRecords", fields: [adjustedBy], references: [id], onDelete: Cascade)

  @@index([recordId])
  @@index([adjustedBy])
  @@index([createdAt])
}

model AcademicPeriod {
  id        String   @id @default(uuid())
  sessionId String
  title     String
  type      String
  start     String
  end       String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
  @@index([type])
  @@index([start, end])
}

model TimetableSlot {
  id         String   @id @default(uuid())
  offeringId String
  weekday    Int
  startTime  String
  endTime    String
  venue      String
  kind       String   @default("lecture")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  offering   Offering             @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  exceptions TimetableException[]

  @@index([offeringId])
  @@index([weekday])
}

model TimetableException {
  id        String   @id @default(uuid())
  slotId    String
  date      String
  kind      String
  newVenue  String?
  newTime   String?
  note      String?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slot    TimetableSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  creator User          @relation("CreatedTimetableExceptions", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([slotId])
  @@index([date])
  @@index([createdBy])
}

model CalendarEvent {
  id               String        @id @default(uuid())
  title            String
  type             String
  start            DateTime
  end              DateTime
  allDay           Boolean       @default(false)
  location         String?
  courseId         String?
  courseCode       String?
  scope            AudienceScope @default(faculty)
  targetDepartment String?
  targetLevel      Int?
  createdBy        String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  creator User @relation("CreatedCalendarEvents", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([start, end])
  @@index([scope])
  @@index([type])
  @@index([courseCode])
  @@index([targetDepartment])
  @@index([targetLevel])
  @@index([createdBy])
}

model StoredFile {
  id             String       @id @default(uuid())
  fileKey        String       @unique
  fileName       String
  mimeType       String
  sizeBytes      Int
  sha256         String
  category       FileCategory
  uploaderId     String
  linkedRecordId String?
  storageDriver  String       @default("disk")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  uploader User @relation("UploadedFiles", fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([uploaderId])
  @@index([linkedRecordId])
}

model UserMaterialProgress {
  id             String    @id @default(uuid())
  userId         String
  materialId     String
  offeringId     String
  completed      Boolean   @default(false)
  completedAt    DateTime?
  lastAccessedAt DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  offering Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@index([userId, lastAccessedAt])
  @@index([userId, offeringId])
  @@index([materialId])
}

model PushSubscription {
  id                  String    @id @default(uuid())
  userId              String
  endpoint            String    @unique
  p256dh              String
  auth                String
  userAgent           String?
  urgentNotices       Boolean   @default(true)
  courseUpdates       Boolean   @default(true)
  assignmentReminders Boolean   @default(true)
  isActive            Boolean   @default(true)
  failureCount        Int       @default(0)
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  lastError           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([isActive, urgentNotices])
}

model OnboardingApplication {
  id                   String            @id @default(uuid())
  applicationNumber    String            @unique
  jambRegNo            String
  fullName             String
  email                String
  phone                String?
  departmentId         String
  entryLevel           Int               @default(100)
  session              String
  status               OnboardingStatus  @default(draft)
  actionRequiredReason String?
  rejectionReason      String?
  accessKeyHash        String
  convertedUserId      String?           @unique
  convertedMatricNo    String?
  convertedAt          DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  department    Department            @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  convertedUser User?                 @relation("ConvertedStudentApplication", fields: [convertedUserId], references: [id], onDelete: SetNull)
  documents     OnboardingDocument[]
  reviewLogs    OnboardingReviewLog[]

  @@unique([jambRegNo, session])
  @@index([jambRegNo])
  @@index([email])
  @@index([departmentId])
  @@index([status])
  @@index([session])
}

model OnboardingDocument {
  id            String            @id @default(uuid())
  applicationId String
  documentType  OnboardingDocType
  title         String
  fileKey       String            @unique
  fileName      String
  mimeType      String
  sizeBytes     Int
  sha256        String
  status        DocReviewStatus   @default(pending)
  reviewNotes   String?
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  application OnboardingApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewer    User?                 @relation("ReviewedOnboardingDocuments", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@unique([applicationId, documentType])
  @@index([applicationId])
  @@index([status])
  @@index([reviewedBy])
}

model OnboardingReviewLog {
  id            String           @id @default(uuid())
  applicationId String
  reviewerId    String?
  fromStatus    OnboardingStatus
  toStatus      OnboardingStatus
  action        String
  notes         String?
  createdAt     DateTime         @default(now())

  application OnboardingApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewer    User?                 @relation("LoggedOnboardingReviews", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([reviewerId])
  @@index([createdAt])
}

model RegistrationGuide {
  id                   String   @id @default(uuid())
  title                String
  session              String
  targetDepartmentCode String?
  steps                Json
  importantNotice      String?
  publishedBy          String
  isPublished          Boolean  @default(true)
  lastUpdatedDate      DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  publisher User @relation("PublishedRegistrationGuides", fields: [publishedBy], references: [id], onDelete: Cascade)

  @@index([session])
  @@index([targetDepartmentCode])
  @@index([isPublished])
}

model StaffInvitation {
  id           String                @id @default(uuid())
  email        String
  fullName     String
  role         Role
  departmentId String
  tokenHash    String                @unique
  invitedById  String
  status       StaffInvitationStatus @default(pending)
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?               @unique
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  department   Department            @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  invitedBy    User                  @relation("SentStaffInvitations", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy   User?                 @relation("AcceptedStaffInvitation", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([tokenHash])
  @@index([departmentId])
  @@index([status])
}

model AdmissionsRoster {
  id              String    @id @default(uuid())
  jambRegNo       String    @unique
  matricNo        String?   @unique
  fullName        String
  email           String?
  departmentCode  String
  level           Int       @default(100)
  session         String
  verificationKey String    // Salted/hashed secret for dual-factor roster verification
  isClaimed       Boolean   @default(false)
  claimedAt       DateTime?
  claimedByUserId String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([jambRegNo])
  @@index([matricNo])
  @@index([departmentCode])
  @@index([isClaimed])
}
