# Application Environment
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Local PostgreSQL Database URLs
DATABASE_URL="postgresql://codics:codics@127.0.0.1:5433/codics?schema=public"
DIRECT_URL="postgresql://codics:codics@127.0.0.1:5433/codics?schema=public"
TEST_DATABASE_URL="postgresql://codics:codics@127.0.0.1:5433/codics_test?schema=public"

# Supabase Dev Database URLs (Connect -> ORM -> Prisma)
SUPABASE_DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
SUPABASE_DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Authentication & Tokens
JWT_SECRET=replace-with-at-least-32-characters-random-string
JWT_TTL=15m
REFRESH_TOKEN_TTL=7d
DEMO_PASSWORD=replace-with-random-demo-password

# File Storage Configuration (S3-Compatible / Cloudflare R2 / Local Disk)
# Set STORAGE_DRIVER=disk for local development/testing, or STORAGE_DRIVER=s3 for production S3/Cloudflare R2
STORAGE_DRIVER=disk
UPLOAD_DIR=./uploads
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=codics-faculty-files
STORAGE_ACCESS_KEY_ID=replace-with-s3-or-r2-access-key-id
STORAGE_SECRET_ACCESS_KEY=replace-with-s3-or-r2-secret-access-key
STORAGE_FORCE_PATH_STYLE=true
STORAGE_URL_EXPIRY_SECONDS=900
